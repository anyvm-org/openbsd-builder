diff --git a/libopenbios/client.c b/libopenbios/client.c
old mode 100644
new mode 100755
index 8b3d582..4f04d72
--- a/libopenbios/client.c
+++ b/libopenbios/client.c
@@ -272,8 +272,15 @@ handle_calls(prom_args_t *pb)
 		return 0;
 	}
 
-	/* Store catch result */
-	pb->args[pb->nargs] = val;
+	/* Store catch result, but only if the client asked for at least one
+	 * return cell. Writing it unconditionally clobbers the cell right
+	 * after the client's argument array; IEEE 1275 clients that invoke
+	 * "call-method" with nreturns == 0 (e.g. the OpenBSD/sparc64 >= 7.3
+	 * kernel and ofwboot calling the MMU "map" method) keep their args
+	 * struct exactly nargs cells long, so the stray store corrupts the
+	 * caller's stack frame. */
+	if (pb->nret > 0)
+		pb->args[pb->nargs] = val;
 	
 	j = dstackcnt;
 	for (i = 1; i < pb->nret; i++, j--) {
